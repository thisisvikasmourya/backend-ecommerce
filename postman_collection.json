{
  "info": {
    "_postman_id": "e-commerce-backend-api-collection",
    "name": "E-Commerce Backend API",
    "description": "Comprehensive Postman collection for all implemented routes in the E-Commerce modular monolith backend (Health, Auth, User Profile, Addresses).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Root & System",
      "item": [
        {
          "name": "Root Service Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns basic API information, version, and status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. Health Checks",
      "item": [
        {
          "name": "Liveness Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Liveness probe returning uptime, timestamp, and healthy status."
          },
          "response": []
        },
        {
          "name": "Readiness Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health", "ready"]
            },
            "description": "Readiness probe inspecting PostgreSQL and Redis connectivity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.tokens) {",
                  "        pm.collectionVariables.set('accessToken', res.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', res.data.tokens.refreshToken);",
                  "        console.log('Tokens updated in collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new user account with hashed password and generates JWT token pair."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.tokens) {",
                  "        pm.collectionVariables.set('accessToken', res.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', res.data.tokens.refreshToken);",
                  "        console.log('Tokens updated in collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user credentials and returns user details + JWT token pair."
          },
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "        console.log('Tokens rotated and updated in collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Rotates refresh token and returns a fresh JWT access & refresh token pair."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the active refresh token in PostgreSQL database."
          },
          "response": []
        },
        {
          "name": "Get Authenticated User (Auth Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Retrieves the currently authenticated user token payload (userId, email, role)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Fetches full profile information for the authenticated user from the database."
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Johnny\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+919876543211\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Updates profile details (firstName, lastName, phone) for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Deactivate Account",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Soft deletes/deactivates the user account (sets isActive: false)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Addresses",
      "item": [
        {
          "name": "List Addresses",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses"]
            },
            "description": "Retrieves all saved delivery/billing addresses for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Create Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.id) {",
                  "        pm.collectionVariables.set('addressId', res.data.id);",
                  "        console.log('addressId updated in collection variables:', res.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"street\": \"123 MG Road, Indiranagar\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"postalCode\": \"560038\",\n  \"country\": \"IN\",\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses"]
            },
            "description": "Creates a new address associated with the authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Address by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses", "{{addressId}}"]
            },
            "description": "Fetches a specific address by its UUID for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Update Address by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"street\": \"456 100 Feet Road, HAL 2nd Stage\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"postalCode\": \"560008\",\n  \"country\": \"IN\",\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses", "{{addressId}}"]
            },
            "description": "Updates address details by ID (street, city, state, postalCode, country, isDefault)."
          },
          "response": []
        },
        {
          "name": "Delete Address by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses", "{{addressId}}"]
            },
            "description": "Deletes an address belonging to the authenticated user."
          },
          "response": []
        }
      ]
    }
  ]
}
